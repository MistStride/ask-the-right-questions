{
  "name": "ask-the-right-questions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "vitest run --configLoader runner tests/unit/content.validation.test.ts && node scripts/check-anchors.mjs",
    "build": "npm run validate && tsc -b && vite build",
    "lint": "oxlint src scripts tests playwright.config.ts vitest.config.ts vite.config.ts",
    "test": "vitest run --configLoader runner",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "preview": "node scripts/preview-docs.mjs",
    "new-level": "node scripts/new-level.mjs"
  },
  "dependencies": {
    "8": "^0.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^13.1.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
